FROM python:3.11-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/var/task

RUN apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-writer \
    libreoffice-core \
    libreoffice-common \
    fonts-dejavu \
    fonts-liberation \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/task

COPY requirements.reports.txt ./requirements.reports.txt
RUN pip install --no-cache-dir -r requirements.reports.txt boto3 awslambdaric

COPY src ./src
COPY Plantillas ./Plantillas

ENTRYPOINT ["/usr/local/bin/python", "-m", "awslambdaric"]
CMD ["src.handlers.workers.report_generate_pdf.handler"]
